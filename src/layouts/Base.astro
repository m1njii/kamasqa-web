---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFab from "../components/WhatsAppFab.astro";
import SEO from "../components/SEO.astro";
import type { Props as SEOProps } from "../components/SEO.astro";

// Todas las props SEO se reenvían a <SEO />. Ver src/components/SEO.astro
type Props = SEOProps;

const seoProps = Astro.props;
const GTM_ID = "GTM-K7DDXNNW";
---

<!doctype html>
<html lang="es" id="top">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#192416" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />

    <!-- SEO On-Page -->
    <SEO {...seoProps} />

    <!-- Google Tag Manager (Partytown Web Worker) -->
    <script
      type="text/partytown"
      is:inline
      set:html={`
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','${GTM_ID}');
      `}
    />
    <!-- End Google Tag Manager -->

    <!-- [SEO TEAM]: Si se agrega sitemap, enlazarlo aquí:
         <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" /> -->

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500;1,9..144,600&family=JetBrains+Mono:wght@500;700&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        const savedTheme = localStorage.getItem("kamasqa_theme") || "light";
        document.documentElement.setAttribute("data-theme", savedTheme);
        if (sessionStorage.getItem("kamasqa_first_load") === "1") {
          document.documentElement.classList.add("skip-preloader");
        }
      } catch (_) {}
    </script>
  </head>
  <body>
    <!-- Google Tag Manager (noscript fallback) -->
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- Animación de Carga Inicial (Solo se ejecuta la primera vez que se ingresa al sitio) -->
    <div class="kamasqa-preloader" id="kamasqa-preloader" aria-hidden="true">
      <div class="preloader-box">
        <div class="preloader-logo">
          <img src="/icon.png" alt="" width="38" height="38" />
          <span>AMASQA</span>
        </div>
        <span class="preloader-sub">INGENIERÍA & DISEÑO WEB</span>
        <div class="preloader-bar">
          <div class="preloader-fill"></div>
        </div>
      </div>
    </div>

    <!-- Lienzo de Fondo con Efecto Luciérnagas Kamasqa (Zero-Lag Hardware Accelerated) -->
    <div class="scroll-ambient-canvas" id="scroll-ambient-canvas" aria-hidden="true">
      <canvas id="fireflies-canvas" class="fireflies-canvas"></canvas>
      <div class="sac-ambient-orb sac-orb-primary"></div>
      <div class="sac-ambient-orb sac-orb-secondary"></div>
      <div class="sac-vignette"></div>
    </div>

    <a href="#main" class="skip">Saltar al contenido</a>
    <Header />
    <main id="main" class="site-main">
      <slot />
    </main>
    <Footer />
    <WhatsAppFab />
  </body>
</html>

<script>
  // Control de animación de carga inicial (solo en el primer ingreso a la web)
  const preloader = document.getElementById("kamasqa-preloader");
  if (preloader && !document.documentElement.classList.contains("skip-preloader")) {
    try {
      sessionStorage.setItem("kamasqa_first_load", "1");
    } catch (_) {}
    window.setTimeout(() => {
      preloader.classList.add("is-done");
      window.setTimeout(() => {
        preloader.remove();
      }, 550);
    }, 820);
  } else if (preloader) {
    preloader.remove();
  }

  // Observador de apariciones al hacer scroll
  const initReveal = () => {
    const items = document.querySelectorAll<HTMLElement>(".reveal:not(.in)");
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("in");
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -4% 0px" },
    );
    items.forEach((el) => io.observe(el));
  };
  initReveal();

  // Control de iluminación ambiental sutil reactiva al scroll (Zero Lag 60/120 FPS)
  const initScrollAmbient = () => {
    const canvas = document.getElementById("scroll-ambient-canvas");
    if (!canvas) return;
    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
          const progress = maxScroll > 0 ? Math.min(1, Math.max(0, window.scrollY / maxScroll)) : 0;
          document.documentElement.style.setProperty("--sp-progress", progress.toFixed(4));
          ticking = false;
        });
        ticking = true;
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  };
  initScrollAmbient();

  // ========================================================
  // SISTEMA DE LUCIÉRNAGAS KAMASQA (ZERO-LAG 60/120 FPS)
  // Partículas luminosas orgánicas con deriva sinusoidal,
  // pulso de intensidad real y adaptación de tono día/noche.
  // ========================================================
  const initFireflies = () => {
    const canvas = document.getElementById("fireflies-canvas") as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let animId = 0;
    let isDark = document.documentElement.getAttribute("data-theme") === "dark";

    const themeObserver = new MutationObserver(() => {
      isDark = document.documentElement.getAttribute("data-theme") === "dark";
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

    interface Firefly {
      x: number;
      y: number;
      baseRadius: number;
      radius: number;
      vx: number;
      vy: number;
      alpha: number;
      pulseAngle: number;
      pulseSpeed: number;
      colorType: number;
    }

    const COUNT = window.innerWidth < 768 ? 20 : 36;
    const fireflies: Firefly[] = [];

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.scale(dpr, dpr);
    };

    const createFirefly = (): Firefly => ({
      x: Math.random() * (width || window.innerWidth),
      y: Math.random() * (height || window.innerHeight),
      baseRadius: Math.random() * 1.6 + 1.2,
      radius: 1.5,
      vx: (Math.random() - 0.5) * 0.4,
      vy: (Math.random() - 0.5) * 0.35 - 0.12,
      alpha: Math.random() * 0.7 + 0.25,
      pulseAngle: Math.random() * Math.PI * 2,
      pulseSpeed: Math.random() * 0.022 + 0.014,
      colorType: Math.floor(Math.random() * 3),
    });

    const init = () => {
      resize();
      fireflies.length = 0;
      for (let i = 0; i < COUNT; i++) {
        fireflies.push(createFirefly());
      }
    };

    let lastScrollY = window.scrollY;
    let scrollVelocity = 0;
    window.addEventListener(
      "scroll",
      () => {
        const current = window.scrollY;
        scrollVelocity = (current - lastScrollY) * 0.035;
        lastScrollY = current;
      },
      { passive: true },
    );

    const render = () => {
      ctx.clearRect(0, 0, width, height);
      scrollVelocity *= 0.92;

      for (let i = 0; i < fireflies.length; i++) {
        const f = fireflies[i];

        f.pulseAngle += f.pulseSpeed;
        f.x += f.vx + Math.sin(f.pulseAngle * 0.7) * 0.25;
        f.y += f.vy - scrollVelocity + Math.cos(f.pulseAngle * 0.5) * 0.2;

        const pulse = Math.sin(f.pulseAngle);
        const currentAlpha = Math.max(0.06, Math.min(0.85, (pulse + 1) * 0.5 * f.alpha));
        f.radius = f.baseRadius * (0.8 + 0.35 * (pulse + 1) * 0.5);

        if (f.x < -25) f.x = width + 25;
        else if (f.x > width + 25) f.x = -25;
        if (f.y < -25) f.y = height + 25;
        else if (f.y > height + 25) f.y = -25;

        // Luces flotantes basadas estrictamente en la paleta oficial Kamasqa:
        // #6E7D4E (Oliva), #D8E0C7 (Salvia), #AA7229 (Ámbar), #F0C48C (Arena)
        let r = 240, g = 196, b = 140; // Arena #F0C48C por defecto
        if (f.colorType === 1) {
          r = 170; g = 114; b = 41; // Ámbar #AA7229
        } else if (f.colorType === 2) {
          r = 216; g = 224; b = 199; // Salvia #D8E0C7
        }

        if (!isDark) {
          if (f.colorType === 0) {
            r = 110; g = 125; b = 78; // Oliva #6E7D4E
          } else if (f.colorType === 1) {
            r = 170; g = 114; b = 41; // Ámbar #AA7229
          } else {
            r = 140; g = 92; b = 30; // Bronce suave
          }
        }

        const glowGrad = ctx.createRadialGradient(f.x, f.y, 0, f.x, f.y, f.radius * 3.8);
        glowGrad.addColorStop(0, `rgba(${r}, ${g}, ${b}, ${currentAlpha * 0.6})`);
        glowGrad.addColorStop(0.5, `rgba(${r}, ${g}, ${b}, ${currentAlpha * 0.18})`);
        glowGrad.addColorStop(1, `rgba(${r}, ${g}, ${b}, 0)`);

        ctx.beginPath();
        ctx.arc(f.x, f.y, f.radius * 3.8, 0, Math.PI * 2);
        ctx.fillStyle = glowGrad;
        ctx.fill();

        ctx.beginPath();
        ctx.arc(f.x, f.y, f.radius, 0, Math.PI * 2);
        ctx.fillStyle = isDark
          ? `rgba(255, 255, 255, ${currentAlpha * 0.95})`
          : `rgba(${r}, ${g}, ${b}, ${currentAlpha * 0.85})`;
        ctx.fill();
      }

      animId = requestAnimationFrame(render);
    };

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        cancelAnimationFrame(animId);
      } else {
        animId = requestAnimationFrame(render);
      }
    });

    window.addEventListener("resize", resize, { passive: true });

    init();
    animId = requestAnimationFrame(render);
  };
  initFireflies();

