---
import { site, wa } from "../../data/site";
---

<section class="band-section">
  <svg class="sec-vector-canvas" viewBox="0 0 1440 460" fill="none" preserveAspectRatio="none" aria-hidden="true">
    <path class="vec-wave-olive" d="M-60 95 Q 480 240 960 90 T 1500 160" />
    <path class="vec-beam-pulse" d="M-60 95 Q 480 240 960 90 T 1500 160" />
    <path class="vec-wave-amber" d="M-60 365 Q 520 220 1020 380 T 1500 310" />
  </svg>
  <div class="container">
    <div class="pavilion reveal">
      <!-- Decoración geométrica sutil de fondo -->
      <div class="pavilion-glow" aria-hidden="true"></div>
      <div class="pavilion-grid-lines" aria-hidden="true"></div>

      <!-- Columna Editorial Izquierda -->
      <div class="pavilion-copy">
        <div class="status-pill">
          <span>Canal Oficial · Atención en Perú</span>
        </div>

        <h2 class="h-lg pavilion-title">
          ¿Hablamos sobre el próximo paso de tu <em>negocio</em>?
        </h2>

        <p class="pavilion-sub">
          Agenda tu reunión inicial de 15 minutos o escríbenos directo. Analizamos tu caso y te preparamos una propuesta clara.
        </p>

        <div class="pavilion-meta">
          <span>✓ Sin compromiso</span>
          <span>✓ {site.hours}</span>
        </div>
      </div>

      <!-- Tarjeta de Contacto Escultórica Derecha -->
      <div class="pavilion-card">
        <a
          href={wa(
            "Hola equipo de Kamasqa Agencia Digital 👋\n\n" +
              "Me gustaría agendar la reunión inicial gratuita de 15 minutos para conversar sobre el sitio web de mi negocio y recibir una cotización formal.\n\n" +
              "• ¿Qué horarios tienen disponibles esta semana?"
          )}
          target="_blank"
          rel="noopener noreferrer"
          class="wa-card"
          aria-label={`Escribir por WhatsApp al ${site.phone}`}
        >
          <div class="wc-top">
            <span class="wc-tag">WHATSAPP DIRECTO</span>
            <span class="wc-online">● En línea</span>
          </div>

          <span class="wc-number">{site.phone}</span>

          <div class="wc-cta">
            <span>Iniciar conversación ahora</span>
            <span class="wc-arrow" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </div>
        </a>

        <div class="card-sub-links">
          <a href="#servicios" class="sub-link">Explorar Servicios →</a>
          <a href={`mailto:${site.email}`} class="sub-link">{site.email}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .band-section {
    padding: clamp(1.5rem, 4vw, 3rem) 0 clamp(4rem, 7.5vw, 6rem);
    position: relative;
  }

  .pavilion {
    position: relative;
    display: grid;
    grid-template-columns: 1.18fr 0.82fr;
    gap: clamp(2rem, 4.5vw, 3.5rem);
    align-items: center;
    background: linear-gradient(140deg, #FFFFFF 0%, #F3F6EC 52%, #FAF1E3 100%);
    border: 2px solid var(--ink);
    border-radius: 30px;
    padding: clamp(2rem, 4.5vw, 3.5rem);
    box-shadow: 0 24px 52px -24px rgba(27, 33, 20, 0.22), 8px 8px 0 var(--c-olive);
    overflow: hidden;
  }

  .pavilion-glow {
    position: absolute;
    right: -8%;
    top: -25%;
    width: 340px;
    height: 340px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(240, 196, 140, 0.45) 0%, transparent 70%);
    pointer-events: none;
  }

  .pavilion-grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(110, 125, 78, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(110, 125, 78, 0.06) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse at right, black 25%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at right, black 25%, transparent 75%);
    pointer-events: none;
  }

  .pavilion-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .status-pill {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.34rem 0.85rem;
    border-radius: 999px;
    background: var(--c-white);
    border: 1px solid var(--c-sage);
    color: var(--c-olive-dark);
  }

  .pavilion-title {
    color: var(--ink);
    margin: 0;
    max-width: 19ch;
  }

  .pavilion-title em {
    font-style: italic;
    color: var(--c-amber);
  }

  .pavilion-sub {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.62;
    color: var(--ink-soft);
    max-width: 48ch;
  }

  .pavilion-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.35rem;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--c-olive-dark);
    margin-top: 0.25rem;
  }

  /* Tarjeta Derecha */
  .pavilion-card {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .wa-card {
    background: var(--ink);
    color: var(--c-white);
    border-radius: 22px;
    padding: 1.5rem 1.65rem;
    border: 2px solid var(--ink);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    text-decoration: none;
    box-shadow: 0 16px 34px -14px rgba(27, 33, 20, 0.4);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .wa-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 40px -14px rgba(27, 33, 20, 0.55);
  }

  .wc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .wc-tag {
    color: var(--c-sand);
  }

  .wc-online {
    color: #7ef0a9;
  }

  .wc-number {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.2rem);
    font-weight: 700;
    line-height: 1.08;
    color: var(--c-white);
  }

  .wc-cta {
    margin-top: 0.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(216, 224, 199, 0.16);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.86rem;
    font-weight: 800;
    color: var(--c-sand);
  }

  .wc-arrow {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--c-amber);
    color: var(--c-white);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease, background 0.25s ease;
  }

  .wa-card:hover .wc-arrow {
    transform: rotate(45deg) scale(1.08);
    background: var(--c-sand);
    color: var(--ink);
  }

  .card-sub-links {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0 0.35rem;
  }

  .sub-link {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-soft);
    transition: color 0.2s ease;
  }

  .sub-link:hover {
    color: var(--c-amber-dark);
  }

  @media (max-width: 860px) {
    .pavilion {
      grid-template-columns: 1fr;
    }
  }
</style>
