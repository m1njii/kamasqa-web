---
import { site, wa } from "../../data/site";
---

<section class="section-contact-reach" id="contacto">
  <div class="container-wide">
    <div class="cr-grid">
      <!-- Columna Izquierda: Titular y Explicación -->
      <div class="cr-copy-side">
        <h2 class="cr-heading">Cómo Contactarnos</h2>

        <p class="cr-lead">
          Creemos en la atención técnica directa. Hablarás directamente con los ingenieros y diseñadores a cargo de tu proyecto, sin intermediarios ni bots que den respuestas genéricas.
        </p>

        <!-- Card de Contacto Inmediato -->
        <div class="cr-quick-bar">
          <div class="cr-qb-left">
            <div class="cr-qb-info">
              <span class="cr-qb-label">Atención Oficial · Perú</span>
              <strong class="cr-qb-val">{site.phone}</strong>
            </div>
          </div>

          <a
            href={wa("Hola Kamasqa 👋 Quisiera hacer una consulta directa sobre el desarrollo de mi web.")}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-pill-action"
          >
            <span>Iniciar chat directo</span>
            <span class="action-arrow-circle" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Matriz de Coordenadas Corporativas -->
      <div class="cr-coords-side">
        <div class="cr-coords-grid">
          <!-- Item 1: Correo -->
          <div class="cr-coord-item">
            <span class="cr-coord-label">Correo Electrónico</span>
            <a href={`mailto:${site.email}`} class="cr-coord-val link-hover">
              {site.email}
            </a>
          </div>

          <!-- Item 2: Teléfono -->
          <div class="cr-coord-item">
            <span class="cr-coord-label">Teléfono & WhatsApp</span>
            <a href={wa()} target="_blank" rel="noopener noreferrer" class="cr-coord-val link-hover">
              {site.phone}
            </a>
          </div>

          <!-- Item 3: Horarios -->
          <div class="cr-coord-item">
            <span class="cr-coord-label">Horario de Atención</span>
            <span class="cr-coord-val">
              {site.hours}
            </span>
          </div>

          <!-- Item 4: Sede -->
          <div class="cr-coord-item">
            <span class="cr-coord-label">Sede & Alcance</span>
            <span class="cr-coord-val">
              {site.location} · Proyectos Globales
            </span>
          </div>
        </div>

        <div class="cr-trust-pill">
          <span class="cr-tp-icon">✓</span>
          <span>Primero conversamos, sin compromiso; después cotizamos.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-contact-reach {
    padding: clamp(3.5rem, 7vw, 6.5rem) 0;
    background-color: transparent;
    color: var(--ink);
    position: relative;
    border-top: 1px solid var(--line);
  }

  .cr-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 5vw, 6rem);
    align-items: center;
  }

  @media (max-width: 960px) {
    .cr-grid {
      grid-template-columns: 1fr;
    }
  }

  .cr-copy-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .cr-heading {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 3.8vw, 3.4rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .cr-lead {
    font-size: clamp(1rem, 1.15vw, 1.125rem);
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 520px;
  }

  /* Barra de Contacto Rápido */
  .cr-quick-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    width: 100%;
    max-width: 540px;
    background: var(--paper-subtle);
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    padding: 0.5rem 0.6rem 0.5rem 1.4rem;
    margin-top: 0.75rem;
    box-shadow: 0 4px 14px rgba(14, 20, 13, 0.05);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .cr-qb-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .cr-qb-info {
    display: flex;
    flex-direction: column;
  }

  .cr-qb-label {
    font-size: 0.75rem;
    color: var(--ink-muted);
    font-weight: 600;
  }

  .cr-qb-val {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--ink);
    font-weight: 700;
  }

  /* Matriz Coordenadas Derecha */
  .cr-coords-side {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .cr-coords-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .cr-coord-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .cr-coord-label {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .cr-coord-val {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
  }

  .link-hover {
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .link-hover:hover {
    color: var(--c-amber);
  }

  .cr-trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1.15rem;
    background: rgba(216, 224, 199, 0.28);
    border: 1px solid rgba(110, 125, 78, 0.22);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    color: var(--ink-soft);
    font-weight: 600;
    align-self: flex-start;
  }

  .cr-tp-icon {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--c-olive);
    color: #FFFFFF;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 900;
    flex-shrink: 0;
  }

  /* REGLAS RESPONSIVE MOBILE DEDICADAS (Corrige deformaciones en celular) */
  @media (max-width: 640px) {
    .cr-quick-bar {
      flex-direction: column;
      align-items: stretch;
      border-radius: 18px;
      padding: 1.15rem;
      gap: 1.1rem;
      margin-top: 0.5rem;
    }

    .cr-qb-left {
      justify-content: flex-start;
      gap: 0.85rem;
    }

    .cr-quick-bar .btn-pill-action {
      width: 100%;
      justify-content: space-between;
      padding: 0.65rem 0.65rem 0.65rem 1.25rem;
    }

    .cr-coords-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .cr-coord-item {
      padding: 0.9rem 1.1rem;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: transparent;
      gap: 0.35rem;
    }

    .cr-coord-val {
      font-size: 1rem;
      word-break: break-word;
    }

    .cr-trust-pill {
      align-self: stretch;
      width: 100%;
      border-radius: 14px;
      padding: 0.85rem 1rem;
      line-height: 1.45;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .cr-tp-icon {
      margin-top: 2px;
    }
  }

  html[data-theme="dark"] .section-contact-reach {
    background-color: transparent;
    border-color: rgba(255, 255, 255, 0.08);
  }

  html[data-theme="dark"] .cr-quick-bar {
    background-color: #151C12;
    border-color: rgba(255, 255, 255, 0.1);
  }

  html[data-theme="dark"] .cr-trust-pill {
    background: rgba(110, 125, 78, 0.12);
    border-color: rgba(216, 224, 199, 0.18);
    color: #D8E0C7;
  }

  html[data-theme="dark"] .cr-tp-icon {
    background: var(--c-olive);
    color: #FFFFFF;
  }

  html[data-theme="dark"] .cr-coord-item {
    border-color: rgba(216, 224, 199, 0.12);
    background-color: transparent !important;
  }

  html[data-theme="dark"] .cr-coord-label {
    color: rgba(216, 224, 199, 0.7);
  }

  html[data-theme="dark"] .cr-coord-val {
    color: #FFFFFF;
  }

  html[data-theme="dark"] .cr-coord-val a:hover {
    color: var(--c-sand);
  }
</style>
