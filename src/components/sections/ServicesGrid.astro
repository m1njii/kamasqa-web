---
import { services, subservices, wa } from "../../data/site";

// Configuraciones visuales y de fondo para cada servicio principal
const serviceThemes = [
  {
    slug: "landing-page",
    category: "Conversión & Campañas",
    time: "4 a 7 días hábiles",
    imgSrc: "/images/services/landing-page.jpg",
    accentTone: "var(--c-amber)",
    leadShort: "Páginas de alta conversión diseñadas para transformar clics de campañas en clientes reales.",
  },
  {
    slug: "web-informativa",
    category: "Autoridad Corporativa",
    time: "7 a 14 días hábiles",
    imgSrc: "/images/services/web-informativa.jpg",
    accentTone: "var(--c-olive)",
    leadShort: "Tu sede digital multipágina para presentar tus servicios, generar respaldo y posicionar en Google.",
  },
  {
    slug: "tienda-online",
    category: "E-Commerce 24/7",
    time: "14 a 21 días hábiles",
    imgSrc: "/images/services/tienda-online.jpg",
    accentTone: "var(--c-sand)",
    leadShort: "Catálogo completo con carrito de compras y pagos integrados con Yape, Plin y tarjetas.",
  },
  {
    slug: "sistema-medida",
    category: "Bespoke & Plataformas",
    time: "3 a 5 semanas",
    imgSrc: "/images/services/sistema-medida.jpg",
    accentTone: "var(--c-sage)",
    leadShort: "Plataformas web avanzadas, paneles administrativos y flujos de negocio a medida.",
  },
];
---

<section id="servicios" class="section services-editorial">
  <div class="container-wide">
    <!-- Encabezado de Sección: Dinámico con conmutador -->
    <header class="sec-head-editorial">
      <div class="she-left">
        <div class="she-badge-wrap">
          <span class="she-badge" id="services-view-badge">Soluciones Web Principales</span>
        </div>
        <h2 class="she-title" id="services-sec-title">Nuestras Soluciones Web</h2>
        <p class="she-desc" id="services-sec-desc">
          Desde una primera cotización transparente hasta la entrega final, tendrás un proceso claro, atención personalizada y soporte continuo.
        </p>
      </div>

      <div class="she-right">
        <button
          type="button"
          id="btn-toggle-services"
          class="btn-pill-action btn-toggle-services"
          aria-expanded="false"
          aria-controls="services-view-stage"
          title="Alternar entre servicios principales y subservicios especializados"
        >
          <span class="btn-toggle-text" id="toggle-btn-label">Ver subservicios y soporte</span>
          <span class="action-arrow-circle toggle-arrow-wrap" aria-hidden="true">
            <svg class="toggle-icon-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </span>
        </button>
      </div>
    </header>

    <!-- Escenario de Vistas con animación cruzada -->
    <div id="services-view-stage" class="services-view-stage" data-current-view="main">
      
      <!-- ========================================================
           VISTA 1: SERVICIOS PRINCIPALES (GRID 4 COLS + POPULAR NOW)
           ======================================================== -->
      <div id="services-main-panel" class="services-panel panel-main is-active">
        <!-- Grid de Tarjetas Verticales (Desktop: 4 cols | Mobile: Carrusel táctil snap) -->
        <div class="cards-carousel-container">
          <div class="cards-vertical-grid" id="services-grid-track">
            {services.map((s, i) => {
              const theme = serviceThemes[i] || serviceThemes[0];
              return (
                <article class="vertical-card" style={`--accent-card:${theme.accentTone}`} data-srv-card={i}>
                  <!-- Fondo Visual del Servicio -->
                  <div class="vc-bg-wrap" aria-hidden="true">
                    <img
                      src={theme.imgSrc}
                      alt={`Render 3D conceptual para ${s.name}`}
                      class="vc-bg-img"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="vc-gradient"></div>
                  </div>

                  <!-- Botón de Flecha Circular Superior Derecha (↗) -->
                  <a
                    href={`/servicios/${s.slug}`}
                    class="vc-arrow-btn"
                    aria-label={`Ver detalles completos de ${s.name}`}
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8">
                      <line x1="7" y1="17" x2="17" y2="7"></line>
                      <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                  </a>

                  <!-- Contenido Anclado al Fondo -->
                  <div class="vc-content">
                    <div class="vc-meta">
                      <span class="vc-num-tag">0{i + 1}</span>
                      <span class="vc-badge">{theme.category}</span>
                      <span class="vc-time">⏱ {theme.time}</span>
                    </div>

                    <h3 class="vc-title">
                      <a href={`/servicios/${s.slug}`} class="vc-title-link">{s.name}</a>
                    </h3>

                    <p class="vc-desc">{s.short}</p>

                    <div class="vc-footer">
                      <span class="vc-pricing">A cotización formal</span>
                      <a href={`/servicios/${s.slug}`} class="vc-cta-text">
                        <span>Ver proyecto</span>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>

          <!-- Indicadores de Carrusel en Móvil -->
          <div class="srv-carousel-dots" id="srv-dots" aria-hidden="true">
            {services.map((_, idx) => (
              <button type="button" class={`s-dot ${idx === 0 ? "active" : ""}`} data-idx={idx} aria-label={`Ver tarjeta ${idx + 1}`}></button>
            ))}
          </div>
        </div>

        <!-- Ticker 'Popular now': En Desktop: Fila horizontal. En Mobile: Stack superpuesto -->
        <div class="popular-ticker-wrap">
          <div class="pt-label-col">
            <span class="pt-tag">Popular now</span>
          </div>

          <div class="pt-items-stage" id="popular-stage">
            {services.map((s, i) => {
              const theme = serviceThemes[i];
              return (
                <a
                  href={`/servicios/${s.slug}`}
                  class={`pt-item ${i === 0 ? "is-top" : ""}`}
                  data-pop-idx={i}
                  data-layer={i}
                  aria-label={`Ver servicio ${s.name}`}
                >
                  <div class="pt-item-inner">
                    <div class="pt-item-head">
                      <span class="pt-item-meta">{s.name} · {theme.time}</span>
                      <span class="pt-item-badge">Destacado</span>
                    </div>
                    <p class="pt-item-title">{theme.leadShort}</p>
                  </div>
                </a>
              );
            })}
          </div>

          <!-- Controles móviles para el stack superpuesto de Popular Now -->
          <div class="pop-stack-controls" id="pop-controls" aria-label="Controles de tarjetas destacadas">
            <button type="button" class="pop-ctrl-btn prev" id="pop-prev" aria-label="Anterior destacada">‹</button>
            <div class="pop-mini-dots" id="pop-mini-dots">
              {services.map((_, i) => (
                <span class={`pm-dot ${i === 0 ? "active" : ""}`} data-pdot={i}></span>
              ))}
            </div>
            <button type="button" class="pop-ctrl-btn next" id="pop-next" aria-label="Siguiente destacada">›</button>
          </div>
        </div>
      </div>

      <!-- ========================================================
           VISTA 2: SUBSERVICIOS ESPECIALIZADOS (3 TARJETAS EN GRID)
           ======================================================== -->
      <div id="services-sub-panel" class="services-panel panel-sub" aria-hidden="true">
        <div class="subservices-editorial-grid">
          
          <!-- SUB 1: ALOJAMIENTO WEB VPS DEDICADO -->
          <article class="sub-card" style={`--sub-accent: ${subservices[0].accentTone};`}>
            <div class="sub-card-topline"></div>
            
            <div class="sub-card-header">
              <div class="sub-meta">
                <span class="sub-num">01</span>
                <span class="sub-badge">{subservices[0].badge}</span>
              </div>
              <span class="sub-time">⏱ {subservices[0].time}</span>
            </div>

            <div class="sub-card-body">
              <div class="sub-tagline">{subservices[0].tagline}</div>
              <h3 class="sub-title">{subservices[0].name}</h3>
              <p class="sub-desc">{subservices[0].description}</p>

              <!-- Lista de especificaciones VPS -->
              <div class="sub-features-block">
                <span class="sub-block-caption">Especificaciones Técnicas Incluidas:</span>
                <ul class="sub-features-list">
                  {subservices[0].highlights.map((feat) => (
                    <li class="sub-feature-item">
                      <span class="sub-check-icon" aria-hidden="true">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                      </span>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="sub-callout-pill">
                <span class="scp-dot"></span>
                <span>Arquitectura aislada sin caídas ni sobrecarga de vecinos.</span>
              </div>
            </div>

            <div class="sub-card-footer">
              <div class="sub-footer-meta">
                <span class="sub-pricing-label">Tarifa mensual o anual</span>
                <span class="sub-status-tag">IP Dedicada</span>
              </div>
              <a
                href={wa(subservices[0].msg)}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-pill-action sub-cta-action"
              >
                <span>Cotizar Alojamiento VPS</span>
                <span class="action-arrow-circle" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </span>
              </a>
            </div>
          </article>

          <!-- SUB 2: CORREOS CORPORATIVOS (3 OPCIONES DIRECTAMENTE VISIBLES) -->
          <article class="sub-card" style={`--sub-accent: ${subservices[1].accentTone};`}>
            <div class="sub-card-topline"></div>

            <div class="sub-card-header">
              <div class="sub-meta">
                <span class="sub-num">02</span>
                <span class="sub-badge">{subservices[1].badge}</span>
              </div>
              <span class="sub-time">⏱ {subservices[1].time}</span>
            </div>

            <div class="sub-card-body">
              <div class="sub-tagline">{subservices[1].tagline}</div>
              <h3 class="sub-title">{subservices[1].name}</h3>
              <p class="sub-desc">{subservices[1].description}</p>

              <!-- Las 3 Opciones Visibles Directamente -->
              <div class="sub-options-block">
                <span class="sub-block-caption">3 Modalidades Disponibles:</span>
                <div class="sub-options-stack">
                  {subservices[1].options?.map((opt, optIdx) => (
                    <div class={`sub-option-box ${optIdx === 1 ? "is-featured" : ""}`}>
                      <div class="sob-top">
                        <strong class="sob-name">{opt.name}</strong>
                        <span class="sob-badge">{opt.badge}</span>
                      </div>
                      <p class="sob-desc">{opt.desc}</p>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Píldoras de Compatibilidad -->
              <div class="sub-pills-row">
                <span class="sub-mini-pill">✓ DKIM / SPF / DMARC</span>
                <span class="sub-mini-pill">✓ Outlook / Gmail / Móvil</span>
                <span class="sub-mini-pill">✓ Antivirus 24/7</span>
              </div>
            </div>

            <div class="sub-card-footer">
              <div class="sub-footer-meta">
                <span class="sub-pricing-label">Bajo tu propio dominio</span>
                <span class="sub-status-tag">Cero Spam</span>
              </div>
              <a
                href={wa(subservices[1].msg)}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-pill-action sub-cta-action"
              >
                <span>Cotizar Correos por WhatsApp</span>
                <span class="action-arrow-circle" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </span>
              </a>
            </div>
          </article>

          <!-- SUB 3: MANTENIMIENTO PUNTUAL / BOLSA DE HORAS (BISECCIONADO) -->
          <article class="sub-card" style={`--sub-accent: ${subservices[2].accentTone};`}>
            <div class="sub-card-topline"></div>

            <div class="sub-card-header">
              <div class="sub-meta">
                <span class="sub-num">03</span>
                <span class="sub-badge">{subservices[2].badge}</span>
              </div>
              <span class="sub-time">⏱ {subservices[2].time}</span>
            </div>

            <div class="sub-card-body">
              <div class="sub-tagline">{subservices[2].tagline}</div>
              <h3 class="sub-title">{subservices[2].name}</h3>
              <p class="sub-desc">{subservices[2].description}</p>

              <!-- Desglose Biseccionado de Alcances -->
              <div class="sub-scopes-block">
                <span class="sub-block-caption">Alcance según tu Tipo de Web:</span>
                
                <div class="sub-scopes-grid">
                  <!-- Scope 1: Landing / Web Informativa -->
                  <div class="sub-scope-card">
                    <div class="ssc-head">
                      <span class="ssc-dot"></span>
                      <strong class="ssc-title">{subservices[2].scopes?.[0].title}</strong>
                    </div>
                    <ul class="ssc-items">
                      {subservices[2].scopes?.[0].items.map((it) => (
                        <li>• {it}</li>
                      ))}
                    </ul>
                  </div>

                  <!-- Scope 2: E-commerce -->
                  <div class="sub-scope-card">
                    <div class="ssc-head">
                      <span class="ssc-dot"></span>
                      <strong class="ssc-title">{subservices[2].scopes?.[1].title}</strong>
                    </div>
                    <ul class="ssc-items">
                      {subservices[2].scopes?.[1].items.map((it) => (
                        <li>• {it}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>

              <div class="sub-callout-pill">
                <span class="scp-dot"></span>
                <span>Resolución de bugs, código complejo y desinfección de malware a pedido.</span>
              </div>
            </div>

            <div class="sub-card-footer">
              <div class="sub-footer-meta">
                <span class="sub-pricing-label">Bolsa de horas o puntual</span>
                <span class="sub-status-tag">Sin mensualidades</span>
              </div>
              <a
                href={wa(subservices[2].msg)}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-pill-action sub-cta-action"
              >
                <span>Consultar Soporte Técnico</span>
                <span class="action-arrow-circle" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </span>
              </a>
            </div>
          </article>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // ========================================================
  // 1. Carrusel de Tarjetas de Servicios en Móvil
  // ========================================================
  const srvGrid = document.getElementById("services-grid-track");
  const srvDots = document.querySelectorAll(".srv-carousel-dots .s-dot");

  if (srvGrid && srvDots.length > 0) {
    const updateSrvDots = () => {
      const scrollLeft = srvGrid.scrollLeft;
      const cardWidth = srvGrid.querySelector<HTMLElement>(".vertical-card")?.offsetWidth || 300;
      const activeIdx = Math.round(scrollLeft / cardWidth);
      srvDots.forEach((dot, idx) => {
        dot.classList.toggle("active", idx === activeIdx);
      });
    };

    srvGrid.addEventListener("scroll", updateSrvDots, { passive: true });

    srvDots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const idx = Number(dot.getAttribute("data-idx") || 0);
        const card = srvGrid.querySelectorAll<HTMLElement>(".vertical-card")[idx];
        if (card) {
          card.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
        }
      });
    });
  }

  // ========================================================
  // 2. Popular Now: Stack Superpuesto en Móvil
  // ========================================================
  const popStage = document.getElementById("popular-stage");
  const popCards = Array.from(document.querySelectorAll<HTMLElement>(".pt-item"));
  const popMiniDots = Array.from(document.querySelectorAll<HTMLElement>(".pop-mini-dots .pm-dot"));
  const popPrevBtn = document.getElementById("pop-prev");
  const popNextBtn = document.getElementById("pop-next");

  if (popStage && popCards.length > 0) {
    let currentIdx = 0;
    const total = popCards.length;
    let autoTimer: number | null = null;

    const renderStack = () => {
      const isMobile = window.innerWidth <= 840;
      if (!isMobile) {
        popCards.forEach((c) => {
          c.style.removeProperty("transform");
          c.style.removeProperty("opacity");
          c.style.removeProperty("z-index");
          c.style.removeProperty("pointer-events");
        });
        return;
      }

      popCards.forEach((card, i) => {
        const rel = (i - currentIdx + total) % total;
        if (rel === 0) {
          card.style.transform = "translate3d(0, 0, 0) scale(1)";
          card.style.opacity = "1";
          card.style.zIndex = "10";
          card.style.pointerEvents = "auto";
        } else if (rel === 1) {
          card.style.transform = "translate3d(0, 12px, -20px) scale(0.95)";
          card.style.opacity = "0.78";
          card.style.zIndex = "8";
          card.style.pointerEvents = "none";
        } else if (rel === 2) {
          card.style.transform = "translate3d(0, 24px, -40px) scale(0.90)";
          card.style.opacity = "0.52";
          card.style.zIndex = "6";
          card.style.pointerEvents = "none";
        } else {
          card.style.transform = "translate3d(0, 36px, -60px) scale(0.85)";
          card.style.opacity = "0.25";
          card.style.zIndex = "4";
          card.style.pointerEvents = "none";
        }
      });

      popMiniDots.forEach((dot, idx) => {
        dot.classList.toggle("active", idx === currentIdx);
      });
    };

    const nextPopCard = () => {
      const topCard = popCards[currentIdx];
      if (window.innerWidth <= 840 && topCard) {
        topCard.style.transform = "translate3d(-100px, -20px, 0) rotate(-6deg) scale(0.88)";
        topCard.style.opacity = "0";
        window.setTimeout(() => {
          currentIdx = (currentIdx + 1) % total;
          renderStack();
        }, 220);
      } else {
        currentIdx = (currentIdx + 1) % total;
        renderStack();
      }
    };

    const prevPopCard = () => {
      currentIdx = (currentIdx - 1 + total) % total;
      renderStack();
    };

    const resetTimer = () => {
      if (autoTimer) window.clearInterval(autoTimer);
      autoTimer = window.setInterval(() => {
        if (window.innerWidth <= 840) {
          nextPopCard();
        }
      }, 5000);
    };

    popMiniDots.forEach((dot, idx) => {
      dot.addEventListener("click", (e) => {
        e.stopPropagation();
        currentIdx = idx;
        renderStack();
        resetTimer();
      });
    });

    popNextBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      e.preventDefault();
      nextPopCard();
      resetTimer();
    });

    popPrevBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      e.preventDefault();
      prevPopCard();
      resetTimer();
    });

    let touchStartX = 0;
    let touchStartY = 0;
    popStage.addEventListener("touchstart", (e) => {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
    }, { passive: true });

    popStage.addEventListener("touchend", (e) => {
      const touchEndX = e.changedTouches[0].clientX;
      const touchEndY = e.changedTouches[0].clientY;
      const diffX = touchEndX - touchStartX;
      const diffY = touchEndY - touchStartY;
      if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 35) {
        if (diffX < 0) nextPopCard();
        else prevPopCard();
        resetTimer();
      }
    }, { passive: true });

    window.addEventListener("resize", renderStack, { passive: true });
    renderStack();
    resetTimer();
  }

  // ========================================================
  // 3. Conmutador Dinámico: Servicios Principales <-> Subservicios
  // ========================================================
  const toggleBtn = document.getElementById("btn-toggle-services");
  const toggleBtnLabel = document.getElementById("toggle-btn-label");
  const viewStage = document.getElementById("services-view-stage");
  const mainPanel = document.getElementById("services-main-panel");
  const subPanel = document.getElementById("services-sub-panel");
  const secTitle = document.getElementById("services-sec-title");
  const secDesc = document.getElementById("services-sec-desc");
  const viewBadge = document.getElementById("services-view-badge");

  if (toggleBtn && viewStage && mainPanel && subPanel) {
    let currentView: "main" | "sub" = "main";
    let isTransitioning = false;

    toggleBtn.addEventListener("click", () => {
      if (isTransitioning) return;
      isTransitioning = true;

      const goingToSub = currentView === "main";

      // 1. Estado de salida en el panel activo
      const outgoingPanel = goingToSub ? mainPanel : subPanel;
      const incomingPanel = goingToSub ? subPanel : mainPanel;

      outgoingPanel.classList.add("is-leaving");
      outgoingPanel.classList.remove("is-active", "is-entering");

      // Microanimación en el botón
      toggleBtn.classList.toggle("is-sub-active", goingToSub);
      toggleBtn.setAttribute("aria-expanded", String(goingToSub));

      window.setTimeout(() => {
        outgoingPanel.style.display = "none";
        outgoingPanel.classList.remove("is-leaving");
        outgoingPanel.setAttribute("aria-hidden", "true");

        incomingPanel.style.display = "block";
        incomingPanel.removeAttribute("aria-hidden");
        // Reflow forzado para asegurar disparo de la animación CSS
        void incomingPanel.offsetWidth;
        incomingPanel.classList.add("is-active", "is-entering");

        // 2. Actualizar textos de cabecera y botón
        if (goingToSub) {
          if (toggleBtnLabel) toggleBtnLabel.textContent = "← Volver a servicios principales";
          if (viewBadge) viewBadge.textContent = "Infraestructura & Soporte Dedicado";
          if (secTitle) secTitle.textContent = "Subservicios & Soporte Técnico";
          if (secDesc) {
            secDesc.textContent =
              "Alojamiento cloud de alto rendimiento, identidades corporativas bajo tu dominio y bolsas de horas para soporte especializado.";
          }
          currentView = "sub";
          viewStage.setAttribute("data-current-view", "sub");
        } else {
          if (toggleBtnLabel) toggleBtnLabel.textContent = "Ver subservicios y soporte";
          if (viewBadge) viewBadge.textContent = "Soluciones Web Principales";
          if (secTitle) secTitle.textContent = "Nuestras Soluciones Web";
          if (secDesc) {
            secDesc.textContent =
              "Desde una primera cotización transparente hasta la entrega final, tendrás un proceso claro, atención personalizada y soporte continuo.";
          }
          currentView = "main";
          viewStage.setAttribute("data-current-view", "main");
        }

        // Si la página tiene sistema bilingüe activo, sincronizar traducciones
        const translator = (window as unknown as { __kamasqaTranslate?: () => void }).__kamasqaTranslate;
        if (typeof translator === "function") {
          translator();
        }

        window.setTimeout(() => {
          incomingPanel.classList.remove("is-entering");
          isTransitioning = false;
        }, 320);
      }, 190);
    });
  }
</script>

