---
import { site, wa } from "../../data/site";

// Nodos activos en el mapa mundial
const activeNodes = [
  { id: "lima", name: "Lima, PE (Sede Central)", cx: 275, cy: 300, isHQ: true, ping: true },
  { id: "bogota", name: "Bogotá, CO", cx: 285, cy: 260, isHQ: false },
  { id: "santiago", name: "Santiago, CL", cx: 295, cy: 380, isHQ: false },
  { id: "buenos-aires", name: "Buenos Aires, AR", cx: 330, cy: 375, isHQ: false },
  { id: "saopaulo", name: "São Paulo, BR", cx: 350, cy: 330, isHQ: false },
  { id: "miami", name: "Miami, US", cx: 290, cy: 195, isHQ: false },
  { id: "newyork", name: "New York, US", cx: 315, cy: 155, isHQ: false },
  { id: "sf", name: "San Francisco, US", cx: 190, cy: 160, isHQ: false },
  { id: "madrid", name: "Madrid, ES", cx: 505, cy: 165, isHQ: false },
  { id: "london", name: "Londres, UK", cx: 505, cy: 130, isHQ: false },
];
---

<section class="section-world-coverage" id="cobertura">
  <div class="container-wide">
    <div class="wc-grid">
      <!-- Columna Izquierda: Copys de Alcance Global & Soporte en Perú -->
      <div class="wc-copy-side">
        <h2 class="wc-heading">
          Proyectos y Cobertura Digital <span class="wc-highlight">sin fronteras</span>.
        </h2>

        <p class="wc-lead">
          Nuestras plataformas operan sobre infraestructura en la nube distribuida globalmente (Edge CDN). Tu web cargará a velocidad instantánea en Perú y cualquier parte del mundo, respaldada por atención directa en tu propio huso horario.
        </p>

        <!-- Bloque de Métricas Clave de Conectividad con Iconos Vectoriales Oficiales -->
        <div class="wc-features-list">
          <div class="wc-feat-item">
            <span class="wc-feat-icon-badge" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </span>
            <div class="wc-feat-body">
              <strong>Sede Central en Lima, Perú</strong>
              <span>Atención técnica directa sin intermediarios de Lunes a Sábado.</span>
            </div>
          </div>

          <div class="wc-feat-item">
            <span class="wc-feat-icon-badge" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </span>
            <div class="wc-feat-body">
              <strong>Red de Distribución Edge CDN</strong>
              <span>Contenido servido desde los 300+ centros de datos más cercanos a cada usuario.</span>
            </div>
          </div>

          <div class="wc-feat-item">
            <span class="wc-feat-icon-badge" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <polyline points="9 12 11 14 15 10"></polyline>
              </svg>
            </span>
            <div class="wc-feat-body">
              <strong>99.9% de Disponibilidad y Seguridad SSL</strong>
              <span>Certificados criptográficos y protección nativa contra caídas de servidor.</span>
            </div>
          </div>
        </div>

        <div class="wc-action-wrap">
          <a
            href={wa("Hola Kamasqa 👋 Quisiera consultar sobre el desarrollo de mi web y su alcance internacional.")}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-pill-action"
          >
            <span>Conversar con un especialista</span>
            <span class="action-arrow-circle" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Mapa Vectorial Dotted (Dot Matrix World Map) -->
      <div class="wc-map-side">
        <div class="wc-map-canvas-wrap">
          <!-- Tag Flotante Sede Central Lima -->
          <div class="wc-hq-pill-floating">
            <span class="wc-hq-text">Lima (HQ) · En Línea · UTC-5</span>
