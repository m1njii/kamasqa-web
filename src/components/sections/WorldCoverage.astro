<style>
  .section-world-coverage {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background-color: transparent;
    color: var(--ink);
    position: relative;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .wc-grid {
    display: grid;
    grid-template-columns: 1.05fr 1.35fr;
    gap: clamp(2.5rem, 5vw, 6rem);
    align-items: center;
  }

  @media (max-width: 1024px) {
    .wc-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Copys Izquierda */
  .wc-copy-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.35rem;
  }

  .wc-heading {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 3.6vw, 3.2rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .wc-highlight {
    color: var(--c-olive-dark);
  }

  html[data-theme="dark"] .wc-highlight {
    color: var(--c-sand);
  }

  .wc-lead {
    font-size: clamp(1rem, 1.15vw, 1.125rem);
    line-height: 1.65;
    color: var(--ink-soft);
  }

  /* Lista de Características */
  .wc-features-list {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    width: 100%;
    margin-top: 0.25rem;
  }

  .wc-feat-item {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
  }

  .wc-feat-icon-badge {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(110, 125, 78, 0.15);
    color: var(--c-olive);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.15rem;
    border: 1px solid rgba(110, 125, 78, 0.3);
  }

  html[data-theme="dark"] .wc-feat-icon-badge {
    background: rgba(110, 125, 78, 0.25);
    color: #D8E0C7;
    border-color: rgba(216, 224, 199, 0.25);
  }

  .wc-feat-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .wc-feat-body strong {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--ink);
  }

  .wc-feat-body span {
    font-size: 0.88rem;
    color: var(--ink-soft);
    line-height: 1.45;
  }

  .wc-action-wrap {
    margin-top: 0.75rem;
  }

  /* Mapa Derecha */
  .wc-map-side {
    position: relative;
    width: 100%;
  }

  .wc-map-canvas-wrap {
    position: relative;
    background: var(--paper-subtle);
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    box-shadow: 0 16px 40px -12px rgba(14, 20, 13, 0.08);
    overflow: hidden;
  }

  .wc-hq-pill-floating {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 1rem;
    background: rgba(14, 20, 13, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
    color: #FFFFFF;
    font-size: 0.8rem;
    font-weight: 700;
    z-index: 5;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }

  .wc-dotted-map {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 2 / 1;
  }

  /* Puntos del Mapa */
  .map-dot {
    fill: rgba(14, 20, 13, 0.18);
    transition: fill 0.2s ease, transform 0.2s ease;
  }

  html[data-theme="dark"] .map-dot {
    fill: rgba(255, 255, 255, 0.2);
  }

  .map-connection-line {
    stroke: rgba(240, 196, 140, 0.45);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
    animation: wc-dash 25s linear infinite;
  }

  @keyframes wc-dash {
    to { stroke-dashoffset: -100; }
  }

  /* Nodos Activos */
  .map-node .node-core {
    fill: var(--c-amber);
  }

  .map-node .node-glow-ring {
    fill: rgba(170, 114, 41, 0.35);
  }

  .map-node.is-hq .node-core {
    fill: var(--c-sand);
    filter: drop-shadow(0 0 5px var(--c-amber));
  }

  .node-ripple-pulse {
    fill: none;
    stroke: var(--c-sand);
    stroke-width: 1.5;
    opacity: 0.75;
    animation: wc-ripple 2.4s ease-out infinite;
  }

  @keyframes wc-ripple {
    0% { r: 6; opacity: 1; }
    100% { r: 24; opacity: 0; }
  }

  html[data-theme="dark"] .section-world-coverage {
    background-color: transparent;
    border-color: rgba(255, 255, 255, 0.08);
  }

  html[data-theme="dark"] .wc-map-canvas-wrap {
    background-color: #141A12;
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.6);
  }
</style>
