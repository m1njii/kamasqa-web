              <circle cx="290" cy="370" r="3" class="map-dot" />
              <circle cx="310" cy="370" r="3" class="map-dot" />
              <circle cx="330" cy="375" r="3" class="map-dot" />
              <circle cx="295" cy="400" r="3" class="map-dot" />
              <circle cx="310" cy="405" r="3" class="map-dot" />
              <circle cx="300" cy="430" r="3" class="map-dot" />
            </g>

            <!-- Matriz de Puntos de Fondo (Europa & África) -->
            <g class="dot-cluster continent-eu-af">
              <!-- Europa Norte & UK -->
              <circle cx="490" cy="110" r="3" class="map-dot" />
              <circle cx="510" cy="100" r="3" class="map-dot" />
              <circle cx="530" cy="95" r="3" class="map-dot" />
              <circle cx="550" cy="105" r="3" class="map-dot" />
              <circle cx="505" cy="130" r="3" class="map-dot" />
              <circle cx="525" cy="125" r="3" class="map-dot" />
              <circle cx="545" cy="125" r="3" class="map-dot" />
              <circle cx="565" cy="125" r="3" class="map-dot" />
              <!-- España / Francia / Italia / Europa Central -->
              <circle cx="485" cy="155" r="3" class="map-dot" />
              <circle cx="505" cy="155" r="3" class="map-dot" />
              <circle cx="525" cy="150" r="3" class="map-dot" />
              <circle cx="545" cy="150" r="3" class="map-dot" />
              <circle cx="565" cy="150" r="3" class="map-dot" />
              <circle cx="495" cy="175" r="3" class="map-dot" />
              <circle cx="515" cy="175" r="3" class="map-dot" />
              <circle cx="535" cy="175" r="3" class="map-dot" />
              <circle cx="555" cy="175" r="3" class="map-dot" />
              <!-- Norte & Centro África -->
              <circle cx="480" cy="210" r="3" class="map-dot" />
