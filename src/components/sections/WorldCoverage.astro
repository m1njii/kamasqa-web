            </g>

            <!-- Líneas de Enlace Curvas y Conectividad (Ligeras, elegantes) -->
            <path
              d="M275 300 Q 380 210, 505 165"
              class="map-connection-line"
            />
            <path
              d="M275 300 Q 230 220, 190 160"
              class="map-connection-line"
            />
            <path
              d="M275 300 Q 290 220, 315 155"
              class="map-connection-line"
            />
            <path
              d="M275 300 Q 310 340, 330 375"
              class="map-connection-line"
            />

            <!-- Nodos Activos Brillantes (Lime Glowing Dots) -->
            {activeNodes.map((node) => (
              <g class={`map-node ${node.isHQ ? "is-hq" : ""}`} id={`node-${node.id}`}>
                {node.isHQ && (
                  <circle cx={node.cx} cy={node.cy} r="14" class="node-ripple-pulse" />
                )}
                <circle cx={node.cx} cy={node.cy} r={node.isHQ ? "6.5" : "4.5"} class="node-glow-ring" />
