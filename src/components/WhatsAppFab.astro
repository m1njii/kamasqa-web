---
import { wa } from "../data/site";
---

<aside class="fab-wrapper" aria-label="Contacto directo por WhatsApp">
  <a
    href={wa()}
    target="_blank"
    rel="noopener noreferrer"
    class="fab-editorial"
    aria-label="Escribir por WhatsApp"
    title="Hablar con Kamasqa por WhatsApp"
  >
    <!-- Tooltip Flotante Editorial en Hover -->
    <span class="fab-tooltip" aria-hidden="true">
      <span class="tooltip-text">Chatear con nosotros</span>
      <span class="tooltip-arrow"></span>
    </span>

    <!-- Núcleo del Botón -->
    <div class="fab-pill">
      <!-- Indicador de Estado Activo (Punto verde fijo y elegante) -->
      <span class="fab-status-dot" aria-hidden="true" title="Equipo en línea"></span>

      <!-- Icono Oficial Vectorial WhatsApp -->
      <svg class="fab-icon" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.16 12.04 20.16C10.66 20.16 9.3 19.8 8.1 19.11L7.76 18.91L4.65 19.73L5.48 16.7L5.26 16.34C4.5 15.13 4.1 13.54 4.1 11.91C4.1 7.37 7.51 3.67 12.05 3.67ZM8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7.02 8.48 7.02 9.68C7.02 10.89 7.9 12.05 8.02 12.21C8.15 12.37 9.74 14.82 12.18 15.87C12.76 16.12 13.21 16.27 13.57 16.38C14.16 16.57 14.7 16.54 15.12 16.48C15.6 16.41 16.59 15.88 16.8 15.3C17 14.71 17 14.21 16.94 14.11C16.88 14 16.71 13.94 16.46 13.82C16.21 13.7 14.98 13.09 14.75 13.01C14.52 12.93 14.36 12.89 14.2 13.13C14.03 13.38 13.56 13.94 13.41 14.11C13.27 14.27 13.12 14.29 12.87 14.17C12.63 14.05 11.83 13.78 10.89 12.94C10.15 12.28 9.66 11.47 9.51 11.22C9.37 10.98 9.5 10.84 9.62 10.72C9.73 10.61 9.87 10.43 10 10.28C10.13 10.13 10.17 10.03 10.25 9.86C10.33 9.7 10.29 9.56 10.23 9.44C10.17 9.31 9.7 8.16 9.5 7.68C9.31 7.21 9.11 7.27 8.96 7.26C8.82 7.26 8.67 7.25 8.53 7.25V7.33Z"/>
      </svg>
    </div>
  </a>
</aside>

<style>
  .fab-wrapper {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 65;
    pointer-events: none;
  }

  .fab-editorial {
    pointer-events: auto;
    position: relative;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }

  .fab-pill {
    position: relative;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #0E140D;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow:
      0 10px 25px -4px rgba(0, 0, 0, 0.35),
      0 0 0 1px rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .fab-icon {
    width: 26px;
    height: 26px;
    fill: #FFFFFF;
    transition: fill 0.2s ease, transform 0.2s ease;
  }

  /* Punto indicador de disponibilidad (fijo, sutil, elegante) */
  .fab-status-dot {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c-sand, #F0C48C);
    border: 2px solid #0E140D;
    box-shadow: 0 0 6px rgba(240, 196, 140, 0.6);
  }

  /* Microinteracción en hover: elevación suave y sutil brillo cálido */
  .fab-editorial:hover .fab-pill {
    transform: translateY(-3px) scale(1.05);
    background: #141C12;
    border-color: rgba(240, 196, 140, 0.45);
    box-shadow:
      0 16px 36px -6px rgba(0, 0, 0, 0.45),
      0 0 14px rgba(170, 114, 41, 0.25);
  }

  .fab-editorial:hover .fab-icon {
    fill: var(--c-sand, #F0C48C);
  }

  .fab-editorial:active .fab-pill {
    transform: translateY(0) scale(0.96);
  }

  /* Tooltip Flotante Editorial a la izquierda */
  .fab-tooltip {
    position: absolute;
    right: calc(100% + 12px);
    top: 50%;
    transform: translateY(-50%) translateX(6px);
    background: #0E140D;
    color: #FFFFFF;
    font-family: var(--font-body, system-ui);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-full, 999px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fab-editorial:hover .fab-tooltip {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  /* Adaptación a Modo Noche */
  html[data-theme="dark"] .fab-pill {
    background: #141C12;
    border-color: rgba(255, 255, 255, 0.12);
  }

  html[data-theme="dark"] .fab-status-dot {
    border-color: #141C12;
  }

  html[data-theme="dark"] .fab-tooltip {
    background: #141C12;
    border-color: rgba(255, 255, 255, 0.1);
  }

  /* En pantallas móviles ocultamos el tooltip flotante para no invadir espacio */
  @media (max-width: 768px) {
    .fab-wrapper {
      right: 1.15rem;
      bottom: 1.15rem;
    }

    .fab-pill {
      width: 48px;
      height: 48px;
    }

    .fab-icon {
      width: 24px;
      height: 24px;
    }

    .fab-tooltip {
      display: none !important;
    }
  }
</style>
