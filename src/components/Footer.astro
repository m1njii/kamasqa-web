---
const year = new Date().getFullYear();
---

<footer class="footer-minimal" id="footer">
  <div class="container-wide">
    <div class="fm-top">
      <!-- Marca y Frase Esencial -->
      <div class="fm-brand-col">
        <a href="/" class="fm-logo" aria-label="KAMASQA, ir al inicio">
          <img src="/icon.png" alt="" width="30" height="30" decoding="async" />
          <span class="fm-logo-text">AMASQA</span>
        </a>
        <p class="fm-phrase">
          Ingeniería y diseño web a medida para negocios que buscan liderar en internet.
        </p>
      </div>

      <!-- Redes Sociales Oficiales en Pills -->
      <div class="fm-socials" aria-label="Redes oficiales de Kamasqa">
        <a href="https://www.facebook.com/profile.php?id=61594807477321" target="_blank" rel="noopener noreferrer" class="fm-social-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          <span>Facebook</span>
        </a>

        <a href="https://www.instagram.com/kamasqa.pe/" target="_blank" rel="noopener noreferrer" class="fm-social-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          <span>Instagram</span>
        </a>

        <a href="https://www.tiktok.com/@kamasqa.pe" target="_blank" rel="noopener noreferrer" class="fm-social-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
          </svg>
          <span>TikTok</span>
        </a>

        <a href="https://x.com/kamasqaAD" target="_blank" rel="noopener noreferrer" class="fm-social-pill">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
          <span>X</span>
        </a>
      </div>
    </div>

    <div class="fm-bottom">
      <p class="fm-copy">© {year} KAMASQA. Todos los derechos reservados.</p>
      <div class="fm-legals">
        <a href="/politica-de-privacidad" class="fm-link">Política de Privacidad</a>
        <span class="fm-sep">·</span>
        <a href="/terminos-y-condiciones" class="fm-link">Términos y Condiciones</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-minimal {
    background: #080C07;
    color: #FFFFFF;
    padding: clamp(1.75rem, 3.5vw, 2.75rem) 0 clamp(2.5rem, 4.5vw, 3.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    z-index: 2;
  }

  .fm-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.35rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    flex-wrap: wrap;
  }

  .fm-brand-col {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-width: 500px;
  }

  .fm-logo {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    text-decoration: none;
    color: #FFFFFF;
  }

  .fm-logo img {
    border-radius: 6px;
    display: block;
  }

  .fm-logo-text {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #FFFFFF;
    line-height: 1;
  }

  .fm-phrase {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.62);
    font-weight: 400;
  }

  /* Pills de Redes Sociales */
  .fm-socials {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .fm-social-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .fm-social-pill:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(240, 196, 140, 0.45);
    color: #FFFFFF;
    transform: translateY(-1px);
  }

  /* Barra Inferior */
  .fm-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.15rem;
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.45);
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .fm-copy {
    margin: 0;
  }

  .fm-legals {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .fm-link {
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .fm-link:hover {
    color: var(--c-sand);
  }

  .fm-sep {
    color: rgba(255, 255, 255, 0.25);
  }

  /* Adaptación Responsive Mobile Compacta */
  @media (max-width: 768px) {
    .footer-minimal {
      padding-top: 1.5rem;
      /* Espaciado inferior de seguridad justo para el FAB de WhatsApp sin exceso de vacío */
      padding-bottom: calc(4.2rem + env(safe-area-inset-bottom, 0px));
    }

    .fm-top {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding-bottom: 1rem;
    }

    .fm-brand-col {
      gap: 0.35rem;
    }

    .fm-phrase {
      font-size: 0.8125rem;
      line-height: 1.45;
    }

    .fm-socials {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      width: 100%;
    }

    .fm-social-pill {
      padding: 0.35rem 0.7rem;
      font-size: 0.75rem;
      gap: 0.35rem;
    }

    .fm-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding-top: 0.9rem;
      font-size: 0.74rem;
    }

    .fm-legals {
      gap: 0.45rem 0.65rem;
    }
  }
</style>
