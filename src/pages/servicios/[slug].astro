---
import Base from "../../layouts/Base.astro";
import { services, wa } from "../../data/site";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug);
---

<Base
  title={`${service.name} | KAMASQA — Especificación & Desarrollo`}
  description={service.description}
>
  <!-- Hero Editorial del Servicio -->
  <section class="srv-editorial-hero">
    <div class="container-wide">
      <div class="seh-top-nav">
        <a href="/#servicios" class="seh-back-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 19"></polyline>
          </svg>
          <span>Volver a servicios</span>
        </a>
      </div>

      <div class="seh-split-grid">
        <!-- Columna Izquierda: Información Principal & Acciones -->
        <div class="seh-main-col">
          <h1 class="seh-title">{service.name}</h1>
          <p class="seh-desc">{service.description}</p>

          <div class="seh-chips-row">
            <div class="seh-chip">
              <span class="sc-label">Plazo estimado</span>
              <strong class="sc-val">⏱ {service.time}</strong>
            </div>
            <div class="seh-chip">
              <span class="sc-label">Inversión</span>
              <strong class="sc-val">A cotización formal</strong>
            </div>
          </div>

          <div class="seh-actions">
            <a
              href={wa(service.msg)}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-pill-action"
            >
              <span>Cotizar {service.name} por WhatsApp</span>
              <span class="action-arrow-circle" aria-hidden="true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </span>
            </a>

            <a href="/#metodo" class="btn-editorial-ghost">
              <span>Ver metodología</span>
            </a>
          </div>
        </div>

        <!-- Columna Derecha: Tarjeta Editorial de Rendimiento y Aplicación -->
        <aside class="seh-spec-aside">
          <div class="spec-card-editorial">
            <div class="spe-head">
              <span class="spe-pulse"></span>
              <span class="spe-title">Rendimiento & Impacto</span>
            </div>

            <!-- Métricas Clave -->
            <div class="spe-metrics-grid">
              {service.metrics.map((m) => (
                <div class="spe-metric-item">
                  <span class="spe-m-val">{m.val}</span>
                  <span class="spe-m-label">{m.label}</span>
                </div>
              ))}
            </div>

            <div class="spe-block">
              <span class="spe-block-title">¿Para quién está pensado?</span>
              <p class="spe-block-text">{service.forWho}</p>
            </div>

            <div class="spe-block">
              <span class="spe-block-title">Escenarios de mayor impacto:</span>
              <ul class="spe-cases-list">
                {service.idealCases.map((c) => (
                  <li>
                    <span class="spe-check">✓</span>
                    <span>{c}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Entregables de Ingeniería del Servicio -->
  <section class="section srv-deliverables-section">
    <div class="container-wide">
      <header class="section-head-editorial">
        <h2 class="she-title">Lo que incluye tu proyecto de {service.name}</h2>
        <p class="she-lead">
          Cada componente se construye con código limpio, arquitectura rápida y dirección visual profesional.
        </p>
      </header>

      <div class="deliv-carousel-wrapper" id="deliv-carousel-wrap">
        <div class="deliverables-editorial-grid" id="deliv-track">
          {service.deliverables.map((d, idx) => (
            <article class="deliv-editorial-card" data-deliv-card={idx}>
              <div class="dec-header">
                <span class="dec-number">0{idx + 1}</span>
                <span class="dec-status">Incluido</span>
              </div>
              <h3 class="dec-title">{d.title}</h3>
              <p class="dec-desc">{d.desc}</p>
            </article>
          ))}
        </div>

        <!-- Controles Móviles para Carrusel de Entregables -->
        <div class="deliv-mobile-controls" id="deliv-controls">
          <button type="button" class="dm-arrow-btn" id="deliv-prev" aria-label="Entregable anterior">‹</button>
          <div class="dm-dots" id="deliv-dots">
            {service.deliverables.map((_, i) => (
              <button
                type="button"
                class={`dm-dot ${i === 0 ? "active" : ""}`}
                data-deliv-dot={i}
                aria-label={`Ir al entregable ${i + 1}`}
              />
            ))}
          </div>
          <button type="button" class="dm-arrow-btn" id="deliv-next" aria-label="Siguiente entregable">›</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Especificaciones Técnicas de Serie -->
  <section class="section srv-features-section">
    <div class="container-wide">
      <div class="features-editorial-box">
        <header class="feb-header">
          <h2 class="she-title" style="margin-bottom: 0.5rem;">Especificaciones técnicas de serie</h2>
          <p class="she-lead">
            Sin costos sorpresa ni módulos ocultos. Todo lo necesario para operar y vender con seguridad.
          </p>
        </header>

        <div class="feb-features-grid">
          {service.features.map((f) => (
            <div class="feb-feature-item">
              <span class="feb-icon">✓</span>
              <span class="feb-text">{f}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Otros Servicios Relacionados -->
  <section class="section srv-others-section">
    <div class="container-wide">
      <header class="section-head-editorial">
        <h2 class="she-title">Explora otros formatos web</h2>
      </header>

      <div class="others-carousel-wrapper" id="others-carousel-wrap">
        <div class="others-editorial-grid" id="others-track">
          {others.map((os, idx) => (
            <article class="other-card-editorial" data-other-card={idx}>
              <div class="oce-meta">
                <span class="oce-tag">{os.tag}</span>
                <span class="oce-time">⏱ {os.time}</span>
              </div>
              <h3 class="oce-title">
                <a href={`/servicios/${os.slug}`}>{os.name}</a>
              </h3>
              <p class="oce-desc">{os.short}</p>
              <div class="oce-footer">
                <a href={`/servicios/${os.slug}`} class="link-pill-lime">
                  <span>Ver especificación</span>
                  <span class="lime-dot-arrow" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8">
                      <line x1="7" y1="17" x2="17" y2="7"></line>
                      <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                  </span>
                </a>
              </div>
            </article>
          ))}
        </div>

        <!-- Controles Móviles para Otros Servicios -->
        <div class="others-mobile-controls" id="others-controls">
          <button type="button" class="om-arrow-btn" id="others-prev" aria-label="Formato anterior">‹</button>
          <div class="om-dots" id="others-dots">
            {others.map((_, i) => (
              <button
                type="button"
                class={`om-dot ${i === 0 ? "active" : ""}`}
                data-other-dot={i}
                aria-label={`Ir al formato ${i + 1}`}
              />
            ))}
          </div>
          <button type="button" class="om-arrow-btn" id="others-next" aria-label="Siguiente formato">›</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Conversión Directa de Servicio -->
  <section class="srv-cta-strip">
    <div class="container-wide">
      <div class="scs-card">
        <div class="scs-copy">
          <h3 class="scs-title">¿Listo para comenzar con tu {service.name}?</h3>
          <p class="scs-desc">
            Conversemos 15 minutos sin compromiso. Te brindamos una cotización técnica por escrito con plazos y presupuesto cerrado.
          </p>
        </div>
        <div class="scs-action">
          <a
            href={wa(service.msg)}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-pill-action"
          >
            <span>Cotizar por WhatsApp</span>
            <span class="action-arrow-circle" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ========================================================
     HERO EDITORIAL DE SERVICIO
     ======================================================== */
  .srv-editorial-hero {
    position: relative;
    padding: clamp(6.5rem, 12vh, 8.5rem) 0 clamp(3.5rem, 6vh, 4.5rem);
    background: radial-gradient(circle at 50% 25%, rgba(110, 125, 78, 0.18) 0%, transparent 60%), #0B0F09;
    color: #FFFFFF;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .seh-top-nav {
    margin-bottom: 2rem;
  }

  .seh-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: all 0.2s ease;
  }

  .seh-back-link:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #FFFFFF;
    transform: translateX(-2px);
  }

  .seh-split-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.85fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: flex-start;
  }

  @media (max-width: 960px) {
    .seh-split-grid {
      grid-template-columns: 1fr;
    }
  }

  .seh-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .seh-category-pill {
    display: inline-flex;
    align-items: center;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--c-sand);
    background: rgba(170, 114, 41, 0.16);
    border: 1px solid rgba(240, 196, 140, 0.35);
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
  }

  .seh-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.8vw, 3.8rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #FFFFFF;
    margin-bottom: 1.25rem;
  }

  .seh-desc {
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.75);
    max-width: 680px;
    margin-bottom: 2rem;
  }

  .seh-chips-row {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 2.2rem;
    flex-wrap: wrap;
  }

  .seh-chip {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.75rem 1.2rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
  }

  .sc-label {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .sc-val {
    font-size: 0.95rem;
    color: #FFFFFF;
    font-weight: 700;
  }

  .seh-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-editorial-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.92rem;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.22s ease;
  }

  .btn-editorial-ghost:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.4);
  }

  /* Aside Especificación Editorial */
  .spec-card-editorial {
    background: #141A12;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 2rem;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
  }

  .spe-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: #FFFFFF;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .spe-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c-lime);
    box-shadow: 0 0 7px var(--c-lime);
  }

  .spe-metrics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .spe-metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .spe-m-val {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--c-lime);
    line-height: 1;
  }

  .spe-m-label {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.35;
  }

  .spe-block {
    margin-bottom: 1.25rem;
  }

  .spe-block:last-child {
    margin-bottom: 0;
  }

  .spe-block-title {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 0.45rem;
    text-transform: uppercase;
  }

  .spe-block-text {
    font-size: 0.92rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.88);
  }

  .spe-cases-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .spe-cases-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .spe-check {
    color: var(--c-lime);
    font-weight: 800;
  }

  /* ========================================================
     ENTREGABLES DE INGENIERÍA
     ======================================================== */
  .srv-deliverables-section {
    background: transparent;
    padding: clamp(3.5rem, 7vw, 6.5rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .section-head-editorial {
    margin-bottom: clamp(2rem, 3.5vw, 3rem);
    max-width: 740px;
  }

  .she-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin-bottom: 0.6rem;
  }

  .she-lead {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .deliverables-editorial-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .deliv-editorial-card {
    background: var(--paper-card);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 1.6rem 1.4rem;
    box-shadow: var(--shadow-sm);
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }

  .deliv-editorial-card:hover {
    transform: translateY(-3px);
    border-color: rgba(110, 125, 78, 0.45);
    box-shadow: 0 10px 24px rgba(14, 20, 13, 0.08);
  }

  .dec-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }

  .dec-number {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--c-lime);
    color: #0E140D;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.82rem;
  }

  .dec-status {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-muted);
  }

  .dec-title {
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.5rem;
    line-height: 1.25;
  }

  .dec-desc {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .deliv-mobile-controls {
    display: none;
  }

  /* ========================================================
     ESPECIFICACIONES TÉCNICAS
     ======================================================== */
  .srv-features-section {
    background: transparent;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .features-editorial-box {
    background: var(--paper-card);
    border: 1px solid var(--line);
    border-radius: 26px;
    padding: clamp(2rem, 4vw, 3.5rem);
    box-shadow: var(--shadow-sm);
  }

  .feb-header {
    margin-bottom: 2rem;
    max-width: 680px;
  }

  .feb-features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }

  @media (max-width: 860px) {
    .feb-features-grid {
      grid-template-columns: 1fr;
    }
  }

  .feb-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .feb-icon {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--c-lime-soft);
    color: var(--c-lime);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 800;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .feb-text {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.45;
  }

  /* ========================================================
     OTROS FORMATOS
     ======================================================== */
  .srv-others-section {
    background: transparent;
    padding: clamp(3.5rem, 7vw, 6.5rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .others-editorial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .other-card-editorial {
    background: var(--paper-card);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 1.8rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .other-card-editorial:hover {
    transform: translateY(-3px);
    border-color: rgba(240, 196, 140, 0.45);
    box-shadow: 0 12px 28px rgba(14, 20, 13, 0.08);
  }

  .oce-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }

  .oce-tag {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--c-lime-dark);
    background: var(--c-lime-soft);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
  }

  .oce-time {
    font-size: 0.78rem;
    color: var(--ink-muted);
  }

  .oce-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.65rem;
  }

  .oce-title a {
    text-decoration: none;
    color: inherit;
  }

  .oce-desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--ink-soft);
    margin-bottom: 1.5rem;
  }

  .oce-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .others-mobile-controls {
    display: none;
  }

  /* ========================================================
     CTA STRIP
     ======================================================== */
  .srv-cta-strip {
    background: transparent;
    padding: clamp(2.5rem, 5vw, 4.5rem) 0;
  }

  .scs-card {
    background: #0E140D;
    color: #FFFFFF;
    border-radius: 28px;
    padding: clamp(2rem, 4vw, 3.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    box-shadow: 0 20px 48px -12px rgba(0, 0, 0, 0.4);
    flex-wrap: wrap;
  }

  .scs-copy {
    max-width: 620px;
  }

  .scs-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    font-weight: 700;
    line-height: 1.2;
    color: #FFFFFF;
    margin-bottom: 0.6rem;
  }

  .scs-desc {
    font-size: 0.98rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
  }

  /* ========================================================
     RESPONSIVE EN MÓVIL (<= 860px)
     ======================================================== */
  @media (max-width: 860px) {
    .deliverables-editorial-grid,
    .others-editorial-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 1rem;
      padding-bottom: 0.5rem;
    }

    .deliverables-editorial-grid::-webkit-scrollbar,
    .others-editorial-grid::-webkit-scrollbar {
      display: none;
    }

    .deliv-editorial-card,
    .other-card-editorial {
      flex: 0 0 calc(85% - 0.5rem);
      min-width: 260px;
      scroll-snap-align: center;
    }

    .deliv-mobile-controls,
    .others-mobile-controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin-top: 1rem;
    }

    .dm-arrow-btn,
    .om-arrow-btn {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--paper-card);
      border: 1px solid var(--line);
      color: var(--ink);
      font-size: 1.3rem;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .dm-dots,
    .om-dots {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .dm-dot,
    .om-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--line-strong);
      border: none;
      cursor: pointer;
      padding: 0;
      transition: all 0.2s ease;
    }

    .dm-dot.active,
    .om-dot.active {
      width: 18px;
      border-radius: 4px;
      background: var(--c-lime);
    }
  }

  html[data-theme="dark"] .srv-deliverables-section,
  html[data-theme="dark"] .srv-others-section,
  html[data-theme="dark"] .srv-cta-strip {
    background: transparent;
  }

  html[data-theme="dark"] .srv-features-section {
    background: transparent;
  }

  html[data-theme="dark"] .deliv-editorial-card,
  html[data-theme="dark"] .features-editorial-box,
  html[data-theme="dark"] .other-card-editorial {
    background: rgba(255, 255, 255, 0.035);
    backdrop-filter: blur(10px);
    border-color: rgba(216, 224, 199, 0.12);
  }

  html[data-theme="dark"] .feb-feature-item {
    background: rgba(255, 255, 255, 0.025);
    border-color: rgba(216, 224, 199, 0.08);
  }
</style>

<script>
  // Control de carruseles interactivos en móvil para entregables y otros servicios con autoplay de 5 segundos
  const initDetailCarousel = (trackId: string, dotsSelector: string, prevId: string, nextId: string, autoInterval = 5000) => {
    const track = document.getElementById(trackId);
    const dots = document.querySelectorAll<HTMLButtonElement>(dotsSelector);
    const prevBtn = document.getElementById(prevId);
    const nextBtn = document.getElementById(nextId);

    if (!track || dots.length === 0) return;

    let activeIdx = 0;
    const total = dots.length;
    let autoTimer: number | null = null;

    const scrollTo = (idx: number) => {
      const cards = track.children;
      const card = cards[idx] as HTMLElement;
      if (card) {
        const left = card.offsetLeft - (track.clientWidth - card.clientWidth) / 2;
        track.scrollTo({ left: Math.max(0, left), behavior: "smooth" });
      }
      activeIdx = idx;
      dots.forEach((d, i) => d.classList.toggle("active", i === activeIdx));
    };

    const updateDotsOnScroll = () => {
      const scrollLeft = track.scrollLeft;
      const card = track.children[0] as HTMLElement;
      const cardWidth = card ? card.offsetWidth + 16 : 280;
      const calcIdx = Math.round(scrollLeft / cardWidth);
      const clamped = Math.max(0, Math.min(total - 1, calcIdx));
      if (clamped !== activeIdx) {
        activeIdx = clamped;
        dots.forEach((d, i) => d.classList.toggle("active", i === activeIdx));
      }
    };

    const startAutoplay = () => {
      if (autoTimer) clearInterval(autoTimer);
      if (window.innerWidth <= 860) {
        autoTimer = window.setInterval(() => {
          const next = (activeIdx + 1) % total;
          scrollTo(next);
        }, autoInterval);
      }
    };

    const stopAutoplay = () => {
      if (autoTimer) {
        clearInterval(autoTimer);
        autoTimer = null;
      }
    };

    track.addEventListener("scroll", updateDotsOnScroll, { passive: true });

    let touchStartX = 0;
    track.addEventListener("touchstart", (e) => {
      stopAutoplay();
      touchStartX = e.touches[0].clientX;
    }, { passive: true });

    track.addEventListener("touchend", (e) => {
      const touchEndX = e.changedTouches[0].clientX;
      const diff = touchEndX - touchStartX;
      if (Math.abs(diff) > 40) {
        if (diff < 0) {
          scrollTo((activeIdx + 1) % total);
        } else {
          scrollTo((activeIdx - 1 + total) % total);
        }
      }
      startAutoplay();
    }, { passive: true });

    dots.forEach((dot, idx) => {
      dot.addEventListener("click", () => {
        stopAutoplay();
        scrollTo(idx);
        startAutoplay();
      });
    });

    prevBtn?.addEventListener("click", () => {
      stopAutoplay();
      const next = (activeIdx - 1 + total) % total;
      scrollTo(next);
      startAutoplay();
    });

    nextBtn?.addEventListener("click", () => {
      stopAutoplay();
      const next = (activeIdx + 1) % total;
      scrollTo(next);
      startAutoplay();
    });

    startAutoplay();
    window.addEventListener("resize", () => {
      if (window.innerWidth > 860) stopAutoplay();
      else startAutoplay();
    }, { passive: true });
  };

  initDetailCarousel("deliv-track", "#deliv-dots .dm-dot", "deliv-prev", "deliv-next", 5000);
  initDetailCarousel("others-track", "#others-dots .om-dot", "others-prev", "others-next", 5000);
</script>
