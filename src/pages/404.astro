---
import Base from "../layouts/Base.astro";
---

<Base title="Página no encontrada | KAMASQA">
  <section class="section">
    <div class="container nf">
      <span class="eyebrow">Error 404</span>
      <h1 class="h-xl">Esta página <em class="mark">no existe</em>.</h1>
      <p class="lead">Quizá el enlace cambió. Vuelve al inicio o escríbenos y te ayudamos.</p>
      <a href="/" class="btn btn-ink">Volver al inicio</a>
    </div>
  </section>
</Base>

<style>
  .nf { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; min-height: 50vh; justify-content: center; }
</style>
