  .btn-wa-direct:hover {
    background: #1EBE5D;
  }

  /* =========================================================
     CARA POSTERIOR
     ========================================================= */
  .card-back {
    transform: rotateY(180deg);
    background: var(--paper-card);
    border-color: rgba(170, 114, 41, 0.3);
  }

  .back-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.85rem;
    margin-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
  }

  .back-header-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .back-client-info {
    display: flex;
    flex-direction: column;
  }

  .back-client-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--ink);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .back-tagline {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--c-amber-dark);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .btn-flip-back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    background: var(--paper-subtle);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink-soft);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-flip-back:hover {
    background: var(--c-amber);
    color: var(--c-white);
    border-color: var(--c-amber);
  }

  .back-scroll-content {
    flex: 1;
    overflow-y: auto;
    padding-right: 0.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }

  .back-scroll-content::-webkit-scrollbar {
    width: 4px;
  }

  .back-scroll-content::-webkit-scrollbar-thumb {
    background-color: var(--line-strong);
    border-radius: 4px;
  }

  .back-section {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .back-sub {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--c-olive-dark);
  }

  .back-p {
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--ink-soft);
    line-height: 1.45;
  }

  .back-caps-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .back-caps-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--ink-soft);
    line-height: 1.4;
  }

  .cap-check {
    color: var(--c-olive);
    font-weight: 800;
    font-size: 0.85rem;
    line-height: 1;
  }

  .back-results-box {
    background: var(--c-sand-soft);
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.85rem;
    border: 1px solid rgba(170, 114, 41, 0.25);
    margin-top: 0.25rem;
  }

  .results-kicker {
    display: block;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--c-amber-dark);
    margin-bottom: 0.25rem;
    letter-spacing: 0.04em;
  }

  .results-p {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--ink);
    line-height: 1.45;
  }

  .back-footer-actions {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.5rem;
    align-items: center;
    padding-top: 0.85rem;
    margin-top: 0.5rem;
    border-top: 1px solid var(--line);
    flex-shrink: 0;
  }

  .btn-back-return {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.65rem 0.85rem;
    background: var(--paper-subtle);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-soft);
    min-height: 42px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-back-return:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .btn-back-visit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.65rem 0.85rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    min-height: 42px;
    transition: all 0.2s ease;
  }

  .btn-back-visit:hover {
    background: var(--c-amber);
    color: var(--c-white);
  }

  .btn-back-quote {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.65rem 0.85rem;
    background: #25D366;
    color: #FFFFFF;
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    min-height: 42px;
    transition: background-color 0.2s ease;
  }

  .btn-back-quote:hover {
    background: #1EBE5D;
  }

  /* =========================================================
     TARJETA 7: AQUÍ PODRÍA ESTAR TU PROYECTO
     ========================================================= */
  .bento-card-cta-scene .card-face {
    border: 1.5px dashed rgba(170, 114, 41, 0.45);
    background: linear-gradient(180deg, var(--paper-card) 0%, var(--paper-subtle) 100%);
  }

  .bento-card-cta-scene:hover .card-face {
    border-color: var(--c-amber);
    border-style: solid;
    box-shadow: 0 12px 32px rgba(170, 114, 41, 0.15);
  }

  .badge-cta-num {
    background: var(--c-sand-soft) !important;
    color: var(--c-amber-dark) !important;
  }

  .badge-cta-cat {
    background: var(--c-sage-soft) !important;
    color: var(--c-olive-dark) !important;
  }

  .badge-cta-status {
    color: var(--c-olive-dark) !important;
    font-weight: 700 !important;
  }

  .cta-media-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    background: radial-gradient(circle at 50% 50%, rgba(110, 125, 78, 0.08) 0%, rgba(14, 20, 13, 0.02) 100%), var(--paper-subtle);
    border: 1.5px dashed rgba(170, 114, 41, 0.35);
    border-radius: var(--radius-sm);
  }

  .cta-soon-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
    padding: 1.25rem;
    position: relative;
    z-index: 1;
    transition: transform 0.25s ease;
  }

  .bento-card-cta-scene:hover .cta-soon-box {
    transform: translateY(-2px);
  }

  .cta-soon-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 1.15rem;
    border-radius: var(--radius-full);
    background: var(--paper-card);
    border: 1px solid rgba(170, 114, 41, 0.25);
    box-shadow: var(--shadow-sm);
  }

  .cta-soon-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c-amber);
    box-shadow: 0 0 8px rgba(170, 114, 41, 0.6);
  }

  .cta-soon-label {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .cta-soon-hint {
    font-family: var(--font-body);
    font-size: 0.76rem;
    color: var(--ink-muted);
    letter-spacing: 0.02em;
  }

  .cta-hl-box {
    border-left-color: var(--c-amber) !important;
    background: var(--c-sand-soft) !important;
  }

  .cta-hl-label {
    color: var(--c-amber-dark) !important;
  }

  .tech-tag-cta {
    background: var(--paper-card);
    border-color: rgba(170, 114, 41, 0.35);
    color: var(--ink);
    font-weight: 600;
  }

  .cta-flip-trigger {
    background: rgba(110, 125, 78, 0.12) !important;
    border-color: rgba(110, 125, 78, 0.3) !important;
    color: var(--c-olive-dark) !important;
  }

  .cta-flip-trigger:hover {
    background: rgba(110, 125, 78, 0.2) !important;
    border-color: var(--c-olive) !important;
  }

  .cta-footer-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }

  .btn-cta-card-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.7rem 0.95rem;
    background: #25D366;
    color: #FFFFFF;
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    min-height: 48px;
    transition: all 0.2s ease;
    text-decoration: none;
    white-space: nowrap;
  }

  .btn-cta-card-primary:hover {
    background: #1EBE5D;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3);
  }

  .btn-cta-card-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.7rem 0.85rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: 0.84rem;
    font-weight: 700;
    min-height: 48px;
    transition: all 0.2s ease;
    text-decoration: none;
    white-space: nowrap;
  }

  .btn-cta-card-secondary:hover {
    background: var(--c-amber);
    color: #FFFFFF;
    transform: translateY(-1px);
  }

  .cta-results-box {
    background: var(--c-sand-soft);
    border-color: rgba(170, 114, 41, 0.3);
  }

  .cta-back-footer-actions {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem;
  }

  .cta-btn-wide {
    width: 100%;
  }

  /* =========================================================
     AJUSTES ERGONÓMICOS EN MÓVIL (<= 860px)
     ========================================================= */
  @media (max-width: 860px) {
    .bento-hero {
      padding-top: 6.5rem;
      padding-bottom: 2rem;
    }

    .hero-heading {
      font-size: clamp(2rem, 7.5vw, 2.75rem);
      line-height: 1.15;
    }

    .hero-subheading {
      font-size: 0.95rem;
      line-height: 1.55;
      margin-bottom: 1.5rem;
    }

    .bento-section {
      padding: 1.5rem 0 2.5rem;
    }

    .bento-section .container-wide {
      padding: 0;
      max-width: 100%;
    }

    .bento-card-scene {
      flex: 0 0 var(--mobile-card-w);
      width: var(--mobile-card-w);
      max-width: var(--mobile-card-w);
      height: 690px;
    }

    .card-front .card-header,
    .badge-num,
    .badge-cat,
    .badge-sector {
      display: none !important;
    }

    .card-face {
      padding: 1.15rem 1rem;
    }

    .card-media {
      max-height: 160px;
      margin-bottom: 0.75rem;
    }

    .card-title-group {
      margin-bottom: 0.55rem;
    }

    .card-title {
      font-size: 1.05rem;
      line-height: 1.25;
      margin-bottom: 0.2rem;
    }

    .card-subtitle {
      font-size: 0.74rem;
      margin-bottom: 0.35rem;
    }

    .card-highlight-box {
      padding: 0.65rem 0.8rem;
      margin-bottom: 0.65rem;
    }

    .hl-label {
      font-size: 0.68rem;
      margin-bottom: 0.15rem;
    }

    .hl-text-full {
      font-size: 0.76rem;
      line-height: 1.42;
    }

    .card-tech-group {
      margin-bottom: 0.65rem;
    }

    .tech-group-title {
      font-size: 0.65rem;
      margin-bottom: 0.25rem;
    }

    .tech-tag {
      font-size: 0.66rem;
      padding: 0.12rem 0.4rem;
    }

    .flip-trigger-wrap {
      margin-top: auto;
      margin-bottom: 0.65rem;
      padding-top: 0.5rem;
    }

    .btn-flip-trigger {
      padding: 0.5rem 0.85rem;
      font-size: 0.78rem;
      min-height: 40px;
    }

    .card-footer-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
      flex-shrink: 0;
    }

    .btn-visit,
    .btn-wa-direct {
      padding: 0.5rem 0.75rem;
      font-size: 0.78rem;
      min-height: 42px;
    }

    .portfolio-filter-wrapper {
      padding: 0.85rem 1rem;
      margin-top: 1.15rem;
      border-radius: var(--radius-sm);
    }

    .filter-indicator-text {
      display: none;
    }

    .filter-btn {
      padding: 0.45rem 0.85rem;
      font-size: 0.78rem;
    }

    .btn-cta-card-primary,
    .btn-cta-card-secondary {
      padding: 0.5rem 0.65rem;
      font-size: 0.78rem;
      min-height: 42px;
    }

    /* Back Face on mobile */
    .back-header {
      padding-bottom: 0.5rem;
      margin-bottom: 0.5rem;
    }

    .back-client-name {
      font-size: 0.95rem;
    }

    .back-tagline {
      font-size: 0.65rem;
    }

    .btn-flip-back {
      padding: 0.35rem 0.65rem;
      font-size: 0.72rem;
    }

    .back-section {
      margin-bottom: 0.65rem;
    }

    .back-sub {
      font-size: 0.7rem;
      margin-bottom: 0.2rem;
    }

    .back-p,
    .back-caps-list li,
    .results-p {
      font-size: 0.75rem;
      line-height: 1.38;
    }

    .back-results-box {
      padding: 0.6rem 0.75rem;
    }

    .back-footer-actions {
      padding-top: 0.65rem;
      margin-top: 0.4rem;
      gap: 0.4rem;
    }

    .btn-back-return,
    .btn-back-visit,
    .btn-back-quote {
      padding: 0.45rem 0.6rem;
      font-size: 0.72rem;
      min-height: 40px;
    }

    .bento-footer-cta {
      padding: 2.5rem 0 3.5rem;
    }

    .bento-footer-cta .container-wide {
      padding: 0 1.25rem;
    }

    .cta-box {
      padding: 1.75rem 1.25rem;
      border-radius: var(--radius-sm);
    }

    .cta-h3 {
      font-size: 1.35rem;
      line-height: 1.25;
    }

    .btn-cta-whatsapp {
      width: 100%;
      justify-content: space-between;
      padding: 0.55rem 0.65rem 0.55rem 1.25rem;
    }
  }

  /* =========================================================
     CONTROLES DEL CARRUSEL MÓVIL
     ========================================================= */

  .mobile-carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  @media (min-width: 861px) {
    .mobile-carousel-controls {
      display: none !important;
    }
  }

  .carousel-arrow-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--paper-card);
    border: 1px solid var(--line-strong);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: all 0.2s ease;
  }

  .carousel-arrow-btn:active {
    transform: scale(0.92);
  }

  .carousel-arrow-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .carousel-dots-wrap {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .carousel-dot {
    width: 9px;
    height: 9px;
    border-radius: 50% !important;
    background: rgba(14, 20, 13, 0.25);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: transform 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease;
  }

  .carousel-dot:hover {
    background: rgba(14, 20, 13, 0.45);
    transform: scale(1.15);
  }

  .carousel-dot.active {
    width: 9px;
    height: 9px;
    border-radius: 50% !important;
    background: var(--c-amber);
    transform: scale(1.4);
    box-shadow: 0 0 10px rgba(170, 114, 41, 0.7);
  }

  /* =========================================================
     FOOTER CTA BAND
     ========================================================= */
  .bento-footer-cta {
    padding: clamp(3.5rem, 7vw, 5.5rem) 0;
    background: var(--paper-subtle);
    border-top: 1px solid var(--line);
    position: relative;
  }

  .bento-footer-cta .container-wide {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .cta-box {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
    background: var(--paper-card);
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 860px) {
    .cta-box {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 2.5rem;
    }
  }

  .cta-eyebrow {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-amber-dark);
    margin-bottom: 0.4rem;
  }

  .cta-h3 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.8vw, 2.1rem);
    color: var(--ink);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 0.5rem;
  }

  .cta-p {
    font-family: var(--font-body);
    font-size: clamp(0.88rem, 1.4vw, 0.98rem);
    color: var(--ink-soft);
    max-width: 540px;
    line-height: 1.55;
    margin: 0;
  }

  .btn-cta-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem 0.65rem 0.6rem 1.4rem;
    border-radius: var(--radius-full);
    background: #0E140D;
    color: var(--c-white);
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.35);
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    white-space: nowrap;
  }

  .btn-cta-whatsapp:hover {
    transform: translateY(-2px);
    background: #000000;
    box-shadow: 0 12px 28px -4px rgba(0, 0, 0, 0.5);
  }

  .cta-arrow-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--c-sand);
    color: #172014;
    transition: transform 0.2s ease, background 0.2s ease;
    flex-shrink: 0;
  }

  .btn-cta-whatsapp:hover .cta-arrow-circle {
    transform: translate(2px, -2px);
    background: var(--c-amber);
    color: #FFFFFF;
  }

  /* =========================================================
     MODO NOCHE OFICIAL (html[data-theme="dark"])
     Estética Nocturna Obsidiana-Oliva & Bronce Ámbar
     ========================================================= */

  html[data-theme="dark"] .bento-hero {
    background:
      radial-gradient(ellipse at 50% -10%, rgba(110, 125, 78, 0.22) 0%, rgba(170, 114, 41, 0.1) 45%, transparent 72%),
      #0B1008;
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }

  html[data-theme="dark"] .bento-hero::before {
    background-image: radial-gradient(rgba(216, 224, 199, 0.07) 1px, transparent 0);
    opacity: 0.45;
  }

  html[data-theme="dark"] .bento-back-link {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(216, 224, 199, 0.16);
    color: var(--ink-soft);
  }

  html[data-theme="dark"] .bento-back-link:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    border-color: var(--c-sand);
  }

  html[data-theme="dark"] .live-status-pill {
    background: rgba(110, 125, 78, 0.18);
    border-color: rgba(216, 224, 199, 0.24);
  }

  html[data-theme="dark"] .live-dot {
    background: #4ade80;
    box-shadow: 0 0 8px rgba(74, 222, 128, 0.8);
  }

  html[data-theme="dark"] .live-text {
    color: var(--c-sage);
  }

  html[data-theme="dark"] .hero-kicker {
    color: var(--c-sand);
  }

  html[data-theme="dark"] .text-gradient {
    background: linear-gradient(135deg, var(--c-sage) 0%, var(--c-sand) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

